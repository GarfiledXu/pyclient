{
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "googletest.failed",
                "settings": {
                    "foreground": "#f00"
                }
            },
            {
                "scope": "googletest.passed",
                "settings": {
                    "foreground": "#0f0"
                }
            },
            {
                "scope": "googletest.run",
                "settings": {
                    "foreground": "#0f0"
                }
            }
        ]
    },
    "python.testing.pytestArgs": [
        "test"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#b3fbf5",
        "activityBar.background": "#b3fbf5",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#eb68f7",
        "activityBarBadge.foreground": "#15202b",
        "commandCenter.border": "#15202b99",
        "sash.hoverBorder": "#b3fbf5",
        "statusBar.background": "#83f8ef",
        "statusBar.debuggingBackground": "#f8838c",
        "statusBar.debuggingForeground": "#15202b",
        "statusBar.foreground": "#15202b",
        "statusBarItem.hoverBackground": "#53f5e9",
        "statusBarItem.remoteBackground": "#83f8ef",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.activeBackground": "#83f8ef",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#83f8ef99",
        "titleBar.inactiveForeground": "#15202b99"
    },
    "peacock.color": "#83f8ef"
}